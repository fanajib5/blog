{{ $publishedAt := "" }}
{{ if not .Date.IsZero }}
{{ $publishedAt = .Date.Format "2006-01-02T15:04:05Z" }}
{{ end }}
{{ if not .PublishDate.IsZero }}
{{ $publishedAt = .PublishDate.Format "2006-01-02T15:04:05Z" }}
{{ end }}
{{ $lastmod := "" }}
{{ if not .Lastmod.IsZero }}
{{ $lastmod = .Lastmod.Format "2006-01-02T15:04:05Z" }}
{{ end }}
{{ $data := dict
  "title" .Title
  "publishedAt" $publishedAt
  "lastmod" $lastmod
  "author" (default "Faiq Najib Al-Aziz" .Params.author)
  "description" (default .Summary .Description)
  "body" .RawContent
  "body_clean" (.Content | plainify)
  "url" .Permalink
  "canonical" .Permalink
  "tags" .Params.tags
  "series" .Params.series
  "wordCount" .WordCount
  "readingTime" .ReadingTime
  "language" .Lang
  "type" .Type
  "section" .Section
}}
{{ jsonify $data }}
